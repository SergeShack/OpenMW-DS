+// ********* Converted shader cache *********
+// Converting a shader (glslang, spirv-cross and the string passes) can take over 100 ms on a slow
+// device, and it happens again every time the game starts. When LIBGL_SHADERCACHE_DIR is set, the
+// result of each conversion is kept there as a file, keyed by the source and the settings that
+// change the result, and reused by later runs.
+
+#define SHADERCACHE_MAGIC "G4SC0001"
+
+typedef struct {
+    char magic[8];
+    int type;
+    int es;
+    unsigned int esversion;
+    int simple_shaderconv;
+    int notexarray;
+    int vgpu_backport;
+    int spirv_opt;
+    int highp;
+    int maxvarying;
+    int maxtex;
+    int glsl300es;
+    shaderconv_need_t need; // need before the conversion
+    unsigned int source_len;
+} shadercache_key_t;
+
+static const char* shadercache_dir() {
+    static int checked = 0;
+    static const char* dir = NULL;
+    if (!checked) {
+        checked = 1;
+        dir = getenv("LIBGL_SHADERCACHE_DIR");
+        if (dir && !dir[0]) dir = NULL;
+    }
+    return dir;
+}
+
+static void shadercache_make_key(shader_t* glshader, shadercache_key_t* key) {
+    memset(key, 0, sizeof(*key));
+    memcpy(key->magic, SHADERCACHE_MAGIC, 8);
+    key->type = glshader->type;
+    key->es = globals4es.es;
+    key->esversion = globals4es.esversion;
+    key->simple_shaderconv = globals4es.simple_shaderconv;
+    key->notexarray = globals4es.notexarray;
+    key->vgpu_backport = globals4es.vgpu_backport;
+    const char* opt = getenv("LIBGL_SPIRV-OPT");
+    key->spirv_opt = opt ? atoi(opt) : 0;
+    key->highp = hardext.highp;
+    key->maxvarying = hardext.maxvarying;
+    key->maxtex = hardext.maxtex;
+    key->glsl300es = hardext.glsl300es;
+    memcpy(&key->need, &glshader->need, sizeof(shaderconv_need_t));
+    key->source_len = strlen(glshader->source);
+}
+
+static void shadercache_path(const shadercache_key_t* key, const char* source, char* path, size_t size) {
+    // FNV-1a over the key and the source, only to name the file; the file keeps both to compare
+    uint64_t h = 1469598103934665603ULL;
+    const unsigned char* p = (const unsigned char*)key;
+    for (size_t i = 0; i < sizeof(*key); i++)
+        h = (h ^ p[i]) * 1099511628211ULL;
+    for (p = (const unsigned char*)source; *p; p++)
+        h = (h ^ *p) * 1099511628211ULL;
+    snprintf(path, size, "%s/%016llx.shader", shadercache_dir(), (unsigned long long)h);
+}
+
+static int shadercache_read(const char** p, const char* end, void* out, size_t len) {
+    if ((size_t)(end - *p) < len) return 0;
+    memcpy(out, *p, len);
+    *p += len;
+    return 1;
+}
+
+static const char* shadercache_read_string(const char** p, const char* end) {
+    const char* s = *p;
+    const char* z = memchr(s, 0, end - s);
+    if (!z) return NULL;
+    *p = z + 1;
+    return s;
+}
+
+// Fills the shader from the cache file. Returns 1 if the file was there and matched.
+static int shadercache_load(shader_t* glshader, const shadercache_key_t* key, const char* path) {
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    fseek(f, 0, SEEK_END);
+    long size = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    char* data = (size > 0) ? (char*)malloc(size) : NULL;
+    int ok = data && fread(data, 1, size, f) == (size_t)size;
+    fclose(f);
+    if (!ok) {
+        free(data);
+        return 0;
+    }
+    const char* p = data;
+    const char* end = data + size;
+    shadercache_key_t file_key;
+    shaderconv_need_t need;
+    int essl_320, count, has_converted;
+    ok = shadercache_read(&p, end, &file_key, sizeof(file_key)) && !memcmp(&file_key, key, sizeof(file_key)) &&
+         (size_t)(end - p) > key->source_len && !memcmp(p, glshader->source, key->source_len + 1);
+    if (ok) {
+        p += key->source_len + 1;
+        ok = shadercache_read(&p, end, &need, sizeof(need)) && shadercache_read(&p, end, &essl_320, sizeof(int)) &&
+             shadercache_read(&p, end, &count, sizeof(int)) && count >= 0 &&
+             glshader->uniforms_declarations_count + count <= MAX_UNIFORM_VARIABLE_NUMBER;
+    }
+    const char *names[MAX_UNIFORM_VARIABLE_NUMBER], *values[MAX_UNIFORM_VARIABLE_NUMBER];
+    for (int i = 0; ok && i < count; i++) {
+        names[i] = shadercache_read_string(&p, end);
+        values[i] = names[i] ? shadercache_read_string(&p, end) : NULL;
+        ok = values[i] && strlen(names[i]) < MAX_VARIABLE_LENGTH && strlen(values[i]) < MAX_INITIAL_VALUE_LENGTH;
+    }
+    const char* source = ok ? shadercache_read_string(&p, end) : NULL;
+    ok = source && shadercache_read(&p, end, &has_converted, sizeof(int));
+    const char* converted = (ok && has_converted) ? shadercache_read_string(&p, end) : NULL;
+    if (!ok || (has_converted && !converted)) {
+        free(data);
+        return 0;
+    }
+    memcpy(&glshader->need, &need, sizeof(need));
+    glshader->is_converted_essl_320 = essl_320;
+    for (int i = 0; i < count; i++) {
+        int n = glshader->uniforms_declarations_count++;
+        strcpy(glshader->uniforms_declarations[n].variable, names[i]);
+        strcpy(glshader->uniforms_declarations[n].initial_value, values[i]);
+    }
+    free(glshader->source);
+    glshader->source = strdup(source);
+    glshader->converted = converted ? strdup(converted) : NULL;
+    free(data);
+    return 1;
+}
+
+// Writes the conversion result next to the key; first_uniform is where this conversion's
+// uniform declarations start.
+static void shadercache_store(shader_t* glshader, const shadercache_key_t* key, const char* original,
+                              int first_uniform, const char* path) {
+    char tmp[4096];
+    snprintf(tmp, sizeof(tmp), "%s.%d.tmp", path, (int)getpid());
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return;
+    int count = glshader->uniforms_declarations_count - first_uniform;
+    int has_converted = glshader->converted ? 1 : 0;
+    fwrite(key, sizeof(*key), 1, f);
+    fwrite(original, key->source_len + 1, 1, f);
+    fwrite(&glshader->need, sizeof(glshader->need), 1, f);
+    fwrite(&glshader->is_converted_essl_320, sizeof(int), 1, f);
+    fwrite(&count, sizeof(int), 1, f);
+    for (int i = first_uniform; i < glshader->uniforms_declarations_count; i++) {
+        fwrite(glshader->uniforms_declarations[i].variable, strlen(glshader->uniforms_declarations[i].variable) + 1, 1, f);
+        fwrite(glshader->uniforms_declarations[i].initial_value,
+               strlen(glshader->uniforms_declarations[i].initial_value) + 1, 1, f);
+    }
+    fwrite(glshader->source, strlen(glshader->source) + 1, 1, f);
+    fwrite(&has_converted, sizeof(int), 1, f);
+    if (has_converted) fwrite(glshader->converted, strlen(glshader->converted) + 1, 1, f);
+    int ok = !ferror(f);
+    if (fclose(f) != 0) ok = 0;
+    if (!ok || rename(tmp, path) != 0) remove(tmp);
+}
