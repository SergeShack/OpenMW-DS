+        if (dynamic_cast<osgParticle::ParticleSystem*>(&drawable))
+        {
+            static const osg::ref_ptr<osg::Program> sDsFixedFunctionProgram = new osg::Program;
+            osg::StateSet* stateSet = drawable.getStateSet();
+            if (stateSet && stateSet->getAttribute(osg::StateAttribute::PROGRAM))
+                stateSet->setAttributeAndModes(sDsFixedFunctionProgram, osg::StateAttribute::ON);
+        }
+#endif
