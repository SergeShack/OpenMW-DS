+            mEveryOtherFrame = Settings::water().mReflectionEveryOtherFrame;
+        }
+
+        // Drawing the reflection costs the draw thread as much as a second view of the terrain. Every other frame
+        // the water shows the last one, a frame late, which its ripples hide. While the camera turns, a frame-old
+        // reflection would jump back and forth, so then it is drawn in every frame. Decided once per frame, since
+        // both the culling of the reflection and the water's choice of texture ask.
+        bool renderInFrame(osgUtil::CullVisitor* cv) override
+        {
+            if (!mEveryOtherFrame)
+                return true;
+            const unsigned int frameNumber = cv->getFrameStamp()->getFrameNumber();
+            if (frameNumber == mDecidedFrame)
+                return mRenderDecided;
+            const osg::Matrix& view = *cv->getModelViewMatrix();
+            osg::Vec3f dir(view(0, 2), view(1, 2), view(2, 2));
+            dir.normalize();
+            // about half a degree away from the view of the last drawn reflection
+            const bool turned = dir * mLastRenderedDir < 0.99996f;
+            mRenderDecided = frameNumber % 2 == 0 || turned;
+            mDecidedFrame = frameNumber;
+            if (mRenderDecided)
+                mLastRenderedDir = dir;
+            return mRenderDecided;
         }
 
