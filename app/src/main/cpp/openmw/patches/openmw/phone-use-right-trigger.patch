+    // OpenMW-DS Phone: Use back on Right Trigger and Quick Save on Right Shoulder. A bindings file
+    // saved by an older phone build has Use on Right Shoulder, and defaults never replace an existing
+    // binding, so swap them once, only when both are exactly the old defaults. Like
+    // swapOldUseAndQuickSave, with a marker file of its own. Returns true when the bindings changed.
+    static bool phoneUseOnRightTrigger(
+        ICS::InputControlSystem* inputBinder, const std::filesystem::path& userFile, bool userFileExists)
+    {
+        const std::filesystem::path marker = userFile.parent_path() / "input_v3_phone_use_rt.done";
+        std::error_code ec;
+        if (std::filesystem::exists(marker, ec))
+            return false;
+
+        bool swapped = false;
+        if (userFileExists)
+        {
+            ICS::Control* use = inputBinder->getChannel(A_Use)->getAttachedControls().front().control;
+            ICS::Control* save = inputBinder->getChannel(A_QuickSave)->getAttachedControls().front().control;
+            if (inputBinder->getJoystickButtonBinding(use, sFakeDeviceId, ICS::Control::INCREASE)
+                    == SDL_CONTROLLER_BUTTON_RIGHTSHOULDER
+                && inputBinder->getJoystickAxisBinding(use, sFakeDeviceId, ICS::Control::INCREASE)
+                    == ICS::InputControlSystem::UNASSIGNED
+                && inputBinder->getJoystickAxisBinding(save, sFakeDeviceId, ICS::Control::INCREASE)
+                    == SDL_CONTROLLER_AXIS_TRIGGERRIGHT
+                && inputBinder->getJoystickButtonBinding(save, sFakeDeviceId, ICS::Control::INCREASE)
+                    == ICS_MAX_DEVICE_BUTTONS)
+            {
+                clearAllControllerBindings(inputBinder, use);
+                clearAllControllerBindings(inputBinder, save);
+                use->setValue(0.5f); // axis bindings must start at 0.5
+                use->setInitialValue(0.5f);
+                inputBinder->addJoystickAxisBinding(
+                    use, sFakeDeviceId, SDL_CONTROLLER_AXIS_TRIGGERRIGHT, ICS::Control::INCREASE);
+                save->setValue(0.0f);
+                save->setInitialValue(0.0f);
+                inputBinder->addJoystickButtonBinding(
+                    save, sFakeDeviceId, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, ICS::Control::INCREASE);
+                Log(Debug::Info) << "Moved Use to Right Trigger and Quick Save to Right Shoulder";
+                swapped = true;
+            }
+        }
+
+        std::ofstream out(marker);
+        out << 1;
+        return swapped;
+    }
