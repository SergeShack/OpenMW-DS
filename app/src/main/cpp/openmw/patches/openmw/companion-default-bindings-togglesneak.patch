+    // COMPANION (OpenMW-DS): Use moved from Right Trigger to Right Shoulder and Quick Save the other way.
+    // A bindings file saved by an older build still has the old pair, and defaults never replace an
+    // existing binding, so swap them once. Only when both are exactly the old defaults, so a layout the
+    // player picked is left alone. A marker file next to the bindings makes sure this runs only once.
+    // Returns true when the bindings changed and should be saved.
+    static bool swapOldUseAndQuickSave(
+        ICS::InputControlSystem* inputBinder, const std::filesystem::path& userFile, bool userFileExists)
+    {
+        const std::filesystem::path marker = userFile.parent_path() / "input_v3_use_r1.done";
+        std::error_code ec;
+        if (std::filesystem::exists(marker, ec))
+            return false;
+
+        bool swapped = false;
+        if (userFileExists)
+        {
+            ICS::Control* use = inputBinder->getChannel(A_Use)->getAttachedControls().front().control;
+            ICS::Control* save = inputBinder->getChannel(A_QuickSave)->getAttachedControls().front().control;
+            if (inputBinder->getJoystickAxisBinding(use, sFakeDeviceId, ICS::Control::INCREASE)
+                    == SDL_CONTROLLER_AXIS_TRIGGERRIGHT
+                && inputBinder->getJoystickButtonBinding(use, sFakeDeviceId, ICS::Control::INCREASE)
+                    == ICS_MAX_DEVICE_BUTTONS
+                && inputBinder->getJoystickButtonBinding(save, sFakeDeviceId, ICS::Control::INCREASE)
+                    == SDL_CONTROLLER_BUTTON_RIGHTSHOULDER
+                && inputBinder->getJoystickAxisBinding(save, sFakeDeviceId, ICS::Control::INCREASE)
+                    == ICS::InputControlSystem::UNASSIGNED)
+            {
+                clearAllControllerBindings(inputBinder, use);
+                clearAllControllerBindings(inputBinder, save);
+                use->setValue(0.0f);
+                use->setInitialValue(0.0f);
+                inputBinder->addJoystickButtonBinding(
+                    use, sFakeDeviceId, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, ICS::Control::INCREASE);
+                save->setValue(0.5f); // axis bindings must start at 0.5
+                save->setInitialValue(0.5f);
+                inputBinder->addJoystickAxisBinding(
+                    save, sFakeDeviceId, SDL_CONTROLLER_AXIS_TRIGGERRIGHT, ICS::Control::INCREASE);
+                Log(Debug::Info) << "Moved Use to Right Shoulder and Quick Save to Right Trigger";
+                swapped = true;
+            }
+        }
+
+        std::ofstream out(marker);
+        out << 1;
+        return swapped;
+    }
+
+    // COMPANION (OpenMW-DS): binding a button that another action had leaves that action with no
+    // controller binding, and the bindings file can't tell that apart from an action that never had
+    // one, so on the next start loadControllerDefaults gave it its default button back whenever that
+    // button was free. The actions the player left without a controller binding are written to a
+    // file next to the bindings when they are saved, and their defaults are no longer restored.
+    static std::filesystem::path unboundControllerActionsFile(const std::filesystem::path& userFile)
+    {
+        return userFile.parent_path() / "input_v3_unbound.txt";
+    }
+
+    static std::set<int> readUnboundControllerActions(const std::filesystem::path& userFile)
+    {
+        std::set<int> actions;
+        std::ifstream in(unboundControllerActionsFile(userFile));
+        int action;
+        while (in >> action)
+            actions.insert(action);
+        return actions;
+    }
+
+    static bool hasControllerBinding(ICS::InputControlSystem* inputBinder, ICS::Control* control)
+    {
+        return inputBinder->getJoystickAxisBinding(control, sFakeDeviceId, ICS::Control::INCREASE)
+            != ICS::InputControlSystem::UNASSIGNED
+            || inputBinder->getJoystickButtonBinding(control, sFakeDeviceId, ICS::Control::INCREASE)
+            != ICS_MAX_DEVICE_BUTTONS;
+    }
+
+    // Using hardcoded key defaults is inevitable, if we want the configuration files to stay valid
+    // across different versions of OpenMW (in the case where another input action is added).
+    static void getControllerDefaults(
+        std::map<int, int>& defaultButtonBindings, std::map<int, int>& defaultAxisBindings)
+    {
+        defaultButtonBindings[A_Activate] = SDL_CONTROLLER_BUTTON_A;
+        // COMPANION (OpenMW-DS): controller defaults tuned for the AYN Thor layout. Ready Weapon/Magic
+        // swapped to Y/X; Inventory on D-Pad Up; Rest on Back; Use on Right Shoulder and Quick Save on
+        // Right Trigger (on handhelds whose triggers sit in line with the shoulders, R2 is a reach);
+        // camera zoom on D-Pad Right/Left; Jump on B (B was freed when Inventory moved to D-Pad Up), so
+        // Left Trigger opens the quick keys menu instead. Journal stays on Left Shoulder.
+        defaultButtonBindings[A_Jump] = SDL_CONTROLLER_BUTTON_B;
+        defaultButtonBindings[A_ToggleWeapon] = SDL_CONTROLLER_BUTTON_Y;
+        defaultButtonBindings[A_ToggleSpell] = SDL_CONTROLLER_BUTTON_X;
+        // defaultButtonBindings[A_QuickButtonsMenu] = SDL_GetButtonFromScancode(SDL_SCANCODE_F1); // Need to implement,
+        // should be ToggleSpell(5) AND Wait(9)
+        defaultButtonBindings[A_Sneak] = SDL_CONTROLLER_BUTTON_LEFTSTICK;
+        defaultButtonBindings[A_Journal] = SDL_CONTROLLER_BUTTON_LEFTSHOULDER;
+        defaultButtonBindings[A_Rest] = SDL_CONTROLLER_BUTTON_BACK;
+        defaultButtonBindings[A_TogglePOV] = SDL_CONTROLLER_BUTTON_RIGHTSTICK;
+        defaultButtonBindings[A_Inventory] = SDL_CONTROLLER_BUTTON_DPAD_UP;
+        defaultButtonBindings[A_GameMenu] = SDL_CONTROLLER_BUTTON_START;
+        defaultButtonBindings[A_Use] = SDL_CONTROLLER_BUTTON_RIGHTSHOULDER;
+        defaultButtonBindings[A_ZoomIn] = SDL_CONTROLLER_BUTTON_DPAD_RIGHT;
+        defaultButtonBindings[A_ZoomOut] = SDL_CONTROLLER_BUTTON_DPAD_LEFT;
+
+        defaultAxisBindings[A_MoveForwardBackward] = SDL_CONTROLLER_AXIS_LEFTY;
+        defaultAxisBindings[A_MoveLeftRight] = SDL_CONTROLLER_AXIS_LEFTX;
+        defaultAxisBindings[A_LookUpDown] = SDL_CONTROLLER_AXIS_RIGHTY;
+        defaultAxisBindings[A_LookLeftRight] = SDL_CONTROLLER_AXIS_RIGHTX;
+        defaultAxisBindings[A_QuickSave] = SDL_CONTROLLER_AXIS_TRIGGERRIGHT;
+        defaultAxisBindings[A_QuickKeysMenu] = SDL_CONTROLLER_AXIS_TRIGGERLEFT;
+    }
+
+    // Only actions that have a default are written, so a default added later for an action that has
+    // none today still reaches existing bindings files.
+    static void writeUnboundControllerActions(
+        ICS::InputControlSystem* inputBinder, const std::filesystem::path& userFile)
+    {
+        std::map<int, int> defaultButtonBindings;
+        std::map<int, int> defaultAxisBindings;
+        getControllerDefaults(defaultButtonBindings, defaultAxisBindings);
+
+        std::ofstream out(unboundControllerActionsFile(userFile));
+        for (int i = 0; i < A_Last; ++i)
+        {
+            if (defaultButtonBindings.count(i) == 0 && defaultAxisBindings.count(i) == 0)
+                continue;
+            if (inputBinder->getChannel(i)->getControlsCount() == 0)
+                continue;
+            ICS::Control* control = inputBinder->getChannel(i)->getAttachedControls().front().control;
+            if (!hasControllerBinding(inputBinder, control))
+                out << i << '\n';
+        }
+    }
+
