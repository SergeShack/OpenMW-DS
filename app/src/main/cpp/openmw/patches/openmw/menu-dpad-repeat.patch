     void ControllerManager::update(float dt)
     {
+        // A d-pad direction held in a menu keeps moving the selection, as in console games: after a short
+        // pause it repeats, and after a few steps it goes faster, so a long list can be scrolled through
+        // without pressing again and again.
+        if (mHeldGuiDpadButton != -1)
+        {
+            if (!MWBase::Environment::get().getWindowManager()->isGuiMode()
+                || MWBase::Environment::get().getInputManager()->controlsDisabled())
+                mHeldGuiDpadButton = -1;
+            else
+            {
+                mGuiDpadRepeatTimer -= dt;
+                if (mGuiDpadRepeatTimer <= 0.f)
