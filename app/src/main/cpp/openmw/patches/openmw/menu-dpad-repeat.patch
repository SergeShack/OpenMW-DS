+                    mGuiDpadRepeatTimer = mGuiDpadRepeatCount < 10 ? 0.08f : 0.04f;
+                    ++mGuiDpadRepeatCount;
+                    SDL_ControllerButtonEvent repeat{};
+                    repeat.type = SDL_CONTROLLERBUTTONDOWN;
+                    repeat.which = mHeldGuiDpadDevice;
+                    repeat.button = static_cast<Uint8>(mHeldGuiDpadButton);
+                    repeat.state = SDL_PRESSED;
+                    gamepadToGuiControl(repeat);
+                }
+            }
+        }
