+    }
+
+    void ShadowManager::setSunlight(float brightness, double time)
+    {
+        if (!mEnableShadows || !mOutdoor || mMinimumSunlight <= 0.f)
+            return;
+        // a little above the threshold to turn them on again, so they do not flicker at dusk
+        const bool bright = brightness >= mMinimumSunlight * (mSunShadows ? 1.f : 1.15f);
+        if (!bright)
+            mSunBrightSince = -1.0;
+        else if (mSunBrightSince < 0.0)
+            mSunBrightSince = time;
+        // off at once; on again only after the light has stayed bright for a second, so a lightning flash does not
+        // turn them on for a moment
+        const bool want = bright && (mSunShadows || mSunShadowsUndecided || time - mSunBrightSince >= 1.0);
+        mSunShadowsUndecided = false;
+        if (want == mSunShadows)
+            return;
+        mSunShadows = want;
+        Log(Debug::Info) << "Shadows " << (want ? "on" : "off") << " outdoors, sunlight " << brightness;
+        applyOutdoorShadows();
+    }
 }
