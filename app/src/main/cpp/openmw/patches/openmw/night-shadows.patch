+    void ShadowManager::applyOutdoorShadows()
+    {
+        if (!mEnableShadows || !mOutdoor)
+            return;
+        if (mSunShadows)
+            mShadowTechnique->enableShadows();
+        else
+            mShadowTechnique->disableShadows(true);
+        setShadowMapsDrawn(mSunShadows);
+    }
