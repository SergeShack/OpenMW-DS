+#ifdef __ANDROID__
+    // COMPANION (OpenMW-DS): defined in androidmain.cpp. The gyroscope of a controller connected over
+    // Bluetooth, read by Android: SDL has a controller's gyroscope only on USB. Used while SDL has none.
+    // Neither is used when the player picked the phone's own gyroscope in the launcher.
+    extern "C" bool companionGyroPhoneOnly();
+    extern "C" bool companionPadGyroAvailable();
+    extern "C" void companionPadGyroValues(float* values);
+#endif
+
     bool ControllerManager::isGyroAvailable() const
     {
+#ifdef __ANDROID__
+        if (companionGyroPhoneOnly())
+            return false;
+        if (!mGyroAvailable)
+            return companionPadGyroAvailable();
+#endif
         return mGyroAvailable;
     }
 
