diff -ruN a/components/misc/thread.cpp b/components/misc/thread.cpp
--- a/components/misc/thread.cpp
+++ b/components/misc/thread.cpp
@@ -2,13 +2,18 @@
 
 #include <components/debug/debuglog.hpp>
 
+#include <algorithm>
 #include <cstring>
+#include <string>
 #include <thread>
 
 #ifdef __linux__
 
+#include <fstream>
 #include <pthread.h>
 #include <sched.h>
+#include <unistd.h>
+#include <vector>
 
 namespace Misc
 {
@@ -22,6 +27,56 @@
             Log(Debug::Warning) << "Failed to set idle priority for thread=" << std::this_thread::get_id() << ": "
                                 << std::generic_category().message(errno);
     }
+
+    namespace
+    {
+        // On Android the scheduler picks a core by load, not by priority: an idle priority thread
+        // doing long work still takes a big core, and a thread that is mostly waiting is put on a
+        // little core, where a long frame of its work then takes twice as long. The cores with the
+        // lowest cpu_capacity are the little ones. The affinity is left alone when the capacities
+        // cannot be read or all cores are the same.
+        void setCurrentThreadCores([[maybe_unused]] bool little)
+        {
+#ifdef __ANDROID__
+            const long count = sysconf(_SC_NPROCESSORS_CONF);
+            std::vector<long> capacity;
+            for (long i = 0; i < count && i < CPU_SETSIZE; ++i)
+            {
+                std::ifstream file("/sys/devices/system/cpu/cpu" + std::to_string(i) + "/cpu_capacity");
+                long value = 0;
+                if (!(file >> value) || value <= 0)
+                    return;
+                capacity.push_back(value);
+            }
+            if (capacity.empty())
+                return;
+            const long lowest = *std::min_element(capacity.begin(), capacity.end());
+            if (lowest == *std::max_element(capacity.begin(), capacity.end()))
+                return;
+            cpu_set_t set;
+            CPU_ZERO(&set);
+            for (std::size_t i = 0; i < capacity.size(); ++i)
+                if ((capacity[i] == lowest) == little)
+                    CPU_SET(i, &set);
+            const char* kind = little ? "little" : "big";
+            if (sched_setaffinity(0, sizeof(set), &set) == 0)
+                Log(Debug::Verbose) << "Using the " << kind << " cores for thread=" << std::this_thread::get_id();
+            else
+                Log(Debug::Warning) << "Failed to use the " << kind << " cores for thread="
+                                    << std::this_thread::get_id() << ": " << std::generic_category().message(errno);
+#endif
+        }
+    }
+
+    void setCurrentThreadLittleCores()
+    {
+        setCurrentThreadCores(true);
+    }
+
+    void setCurrentThreadBigCores()
+    {
+        setCurrentThreadCores(false);
+    }
 }
 
