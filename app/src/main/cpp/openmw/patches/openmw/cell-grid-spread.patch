+    void Scene::processPendingCellChange()
+    {
+        if (mPendingCellLoads.empty() && mPendingCellUnloads.empty())
+            return;
+
+        const osg::Vec3f pos = mWorld.getPlayerPtr().getRefData().getPosition().asVec3();
+        auto navigatorUpdateGuard = mNavigator.makeUpdateGuard();
+
+        if (!mPendingCellLoads.empty())
+        {
+            const ESM::ExteriorCellLocation index = mPendingCellLoads.front();
+            mPendingCellLoads.erase(mPendingCellLoads.begin());
+            if (!isCellInCollection(index, mActiveCells))
+                loadCell(mWorld.getWorldModel().getExterior(index), nullptr, mPendingCellRespawn, pos,
+                    navigatorUpdateGuard.get());
+        }
+        else
+        {
+            CellStore* cell = mPendingCellUnloads.front();
+            mPendingCellUnloads.erase(mPendingCellUnloads.begin());
+            unloadCell(cell, navigatorUpdateGuard.get());
+        }
+
+        mNavigator.update(pos, navigatorUpdateGuard.get());
+    }
+
+    void Scene::clearPendingCellChange()
+    {
+        mPendingCellLoads.clear();
+        mPendingCellUnloads.clear();
+    }
