+#ifdef __ANDROID__
+    // COMPANION (OpenMW-DS): a stick, trigger or button read straight from the controller, as Lua mods
+    // do, is read from every open controller rather than only the first one. The touch controller is
+    // a controller of its own, so with another one open first, a mod reading a stick or a trigger saw
+    // only that one. Of the readings, the one furthest from rest is taken.
+    namespace
+    {
+        template <class Function>
+        void forEachOpenController(Function function)
+        {
+            for (int i = 0; i < SDL_NumJoysticks(); ++i)
+            {
+                if (SDL_GameController* controller
+                    = SDL_GameControllerFromInstanceID(SDL_JoystickGetDeviceInstanceID(i)))
+                    function(controller);
+            }
+        }
+    }
+#endif
